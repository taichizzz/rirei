{
  "name": "relay-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Durable handoffs between officially installed coding-agent CLIs.",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "relay": "dist/index.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/index.cjs && chmod +x dist/index.cjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --mac",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "install:local": "npm run build && mkdir -p \"$HOME/.local/bin\" && ln -sf \"$PWD/dist/index.cjs\" \"$HOME/.local/bin/relay\"",
    "launcher:build": "osacompile -o 'Relay Launcher.app' 'scripts/Relay Launcher.applescript'",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.15.3",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.1",
    "eslint": "^9.35.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.rirei.desktop",
    "productName": "Rirei",
    "asar": true,
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/index.cjs",
        "to": "cli/index.cjs"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
